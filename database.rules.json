{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'username', 'displayName']) && newData.child('uid').val() === $uid && newData.child('username').isString() && newData.child('username').val().length <= 24 && newData.child('displayName').isString() && newData.child('displayName').val().length <= 60"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },
    "videos": {
      ".read": "auth != null",
      "$videoId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || data.child('authorUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['authorUid', 'authorName', 'caption', 'videoUrl', 'createdAt', 'privacy']) && newData.child('caption').isString() && newData.child('caption').val().length <= 2200 && newData.child('privacy').val() === 'public'"
      }
    },
    "likes": {
      "$videoId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "comments": {
      "$videoId": {
        ".read": "auth != null",
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || data.child('authorUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['authorUid', 'authorName', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 500"
        }
      }
    },
    "following": {
      "$uid": {
        ".read": "auth != null",
        "$followedUid": {
          ".write": "auth != null && auth.uid === $uid && $followedUid !== auth.uid",
          ".validate": "!newData.exists() || newData.val() === true"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notificationId": {
          ".write": "auth != null && ((!data.exists() && newData.child('fromUid').val() === auth.uid) || auth.uid === $uid)",
          ".validate": "newData.hasChildren(['type', 'fromUid', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 200"
        }
      }
    }
  }
}
